# ---------- LLM / Model Provider ----------
# Any OpenAI-compatible provider works. Leave OPENAI_API_KEY blank to run the
# system in deterministic-fallback mode (remediation will be built from rules +
# grounded WCAG retrieval rather than calling an LLM).
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- Embeddings ----------
# If EMBEDDINGS_PROVIDER=local, sentence-transformers is used (no keys needed).
# If EMBEDDINGS_PROVIDER=openai, the OPENAI_API_KEY above is used.
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# ---------- Browser automation ----------
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_NAV_WAIT=networkidle

# ---------- Storage ----------
SQLITE_PATH=./backend/data/app.db
VECTOR_DB_PATH=./backend/data/vectorstore
ARTIFACTS_DIR=./backend/data/artifacts
WCAG_CORPUS_DIR=./backend/data/wcag_corpus

# ---------- Server ----------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=dev
CORS_ALLOW_ORIGINS=*

# ---------- Scan defaults ----------
DEFAULT_CRAWL_DEPTH=1
DEFAULT_PAGE_LIMIT=5
DEFAULT_USE_SECONDARY=true
DEFAULT_STORE_SCREENSHOTS=true
DEFAULT_STRICT_MODE=false
